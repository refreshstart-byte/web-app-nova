// wrangler.jsonc
"name": "x9zf79eoupqs",
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app-nova",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "e3bc8709-0cc6-422a-9e33-28d51a82cde0","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "d1ddba0cb58f464eaa34b341ad98b38b" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
